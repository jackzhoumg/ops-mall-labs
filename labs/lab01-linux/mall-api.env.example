# /etc/mall-api/mall-api.env（权限 0640，属主 root:mall）
# mall-api 环境变量，变量含义见 docs/CONVENTIONS.md。对应教程：Lab 01 第 5.2 节。
# 注意：systemd 的 EnvironmentFile 不是 shell，不要写 export，值不要加多余空格。
MALL_LISTEN=:8080
# Lab 01 还没有数据库，/readyz 返回 503 是预期的；Lab 02 改成 lab-db1 的地址
MALL_DB_DSN=mall:MallPass123@tcp(127.0.0.1:3306)/mall?parseTime=true&timeout=3s
MALL_REDIS_ADDR=
MALL_REDIS_PASSWORD=
MALL_CACHE_TTL=30s
MALL_VERSION=v1.0.0
# 生产环境必须是 false。故障演练脚本会临时改成 true，fix 脚本再改回来
MALL_DEBUG=false
MALL_LOG_LEVEL=info
