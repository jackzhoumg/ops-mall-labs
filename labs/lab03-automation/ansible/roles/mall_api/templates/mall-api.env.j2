# {{ ansible_managed }}
# mall-api 环境变量，变量含义见 docs/CONVENTIONS.md
MALL_LISTEN=:{{ mall_api_port }}
MALL_DB_DSN={{ mall_api_db_dsn }}
MALL_REDIS_ADDR={{ mall_api_redis_addr }}
