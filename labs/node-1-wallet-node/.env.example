# Node-1：复制成 .env 后按需修改（docker compose 会自动读取同目录的 .env）
# 写作时版本，以官方发布页为准：
#   Geth       https://github.com/ethereum/go-ethereum/releases
#   Lighthouse https://github.com/sigp/lighthouse/releases
GETH_IMAGE=ethereum/client-go:v1.17.10
LIGHTHOUSE_IMAGE=sigp/lighthouse:v8.3.3

# 网络：hoodi（默认，磁盘小，本实验主线）或 sepolia（应用开发测试网，磁盘要 2TB）
NETWORK=hoodi
# 检查点同步地址，从 https://eth-clients.github.io/checkpoint-sync-endpoints/ 选一个对应网络的
#   hoodi:   https://hoodi.checkpoint.sigp.io
#   sepolia: https://checkpoint-sync.sepolia.ethpandaops.io
CHECKPOINT_SYNC_URL=https://hoodi.checkpoint.sigp.io

# 数据目录，放在独立的 SSD / NVMe 上
DATA_DIR=/data/eth

# 指标端口（6060 / 5054）绑定的地址：填本机内网 IP，只让内网的 Prometheus 访问；不要填 0.0.0.0 暴露到公网
METRICS_BIND=192.168.56.31

# Geth 缓存（MB），16G 内存的机器给 4096
GETH_CACHE=4096
