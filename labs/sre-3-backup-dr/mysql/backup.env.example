# MySQL 备份脚本的配置，复制到 /etc/mall-backup/backup.env 后按实际修改：
#   sudo install -d -m 700 /etc/mall-backup
#   sudo install -m 600 mysql/backup.env.example /etc/mall-backup/backup.env

# rclone 远端：<rclone.conf 里的名字>:<桶名>
RCLONE_REMOTE=s3backup:mysql-backup
# rclone 配置文件（里面有对象存储的访问密钥，权限 600）
RCLONE_CONFIG=/etc/mall-backup/rclone.conf
# 区分不同数据库实例的目录名，binlog 会传到 <桶>/binlog/<HOST_TAG>/
HOST_TAG=lab-db1
# 本地备份目录（最好是单独的磁盘，不要和数据目录放在一起）
BACKUP_DIR=/data/backup/mysql
# 备份账号的连接配置（mysql/backup-my.cnf.example）
MYSQL_DEFAULTS=/etc/mall-backup/my.cnf
# 本地保留天数（远端保留由对象存储的生命周期规则或 REMOTE_KEEP_DAYS 控制）
KEEP_LOCAL_DAYS=3
# 远端全备保留天数，0 表示脚本不删远端，交给对象存储的生命周期规则（推荐）：
# 备份账号只有写入权限、没有删除权限（seaweedfs/policy-mysql-backup.json），
# 数据库主机被入侵时，攻击者也删不掉远端备份
REMOTE_KEEP_DAYS=0
# 要备份的库，空格分隔
DATABASES="mall"
# node_exporter textfile collector 目录，留空则不写备份指标
TEXTFILE_DIR=/var/lib/node_exporter/textfile
# 每次上传 binlog 前是否先 FLUSH BINARY LOGS（1 = 是）。
# 只有“已经关闭”的 binlog 才会上传，FLUSH 让当前文件立刻关闭，RPO 就约等于定时器间隔
FLUSH_BINLOG=1
