# rclone 连接 MinIO 的配置。
# lab-db1：复制到 /etc/mall-backup/rclone.conf（权限 600），填备份账号 mall-mysql-backup 的密钥
# lab-dev：复制到 ~/.config/rclone/rclone.conf（权限 600），恢复时用（可以填 root 账号或单独的只读账号）
#
# 写作时 rclone v1.76.0，安装：sudo dnf install -y rclone（EPEL）或 https://rclone.org/install/
[minio]
type = s3
provider = Minio
endpoint = http://192.168.56.15:9000
access_key_id = mall-mysql-backup
secret_access_key = <换成你的密钥>
# MinIO 默认区域
region = us-east-1
# 不检查、不自动创建桶：桶由管理员提前建好，备份账号没有建桶权限
no_check_bucket = true
