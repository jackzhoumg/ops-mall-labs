# 由 Terraform 生成，不要手改。重新生成：terraform apply
# 环境：${env}
[all:vars]
ansible_user=root
ansible_ssh_private_key_file=${ssh_key}
ansible_python_interpreter=/usr/bin/python3

%{ for group, hosts in groups ~}
[${group}]
%{ for h in hosts ~}
${h} ansible_host=${servers[h].public_ip} private_ip=${servers[h].private_ip}
%{ endfor ~}

%{ endfor ~}
