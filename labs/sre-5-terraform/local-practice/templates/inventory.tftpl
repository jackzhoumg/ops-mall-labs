# 由 Terraform 生成，不要手改。workspace：${env}
[all:vars]
ansible_user=${ansible_user}
ansible_ssh_private_key_file=${ssh_key}
ansible_python_interpreter=/usr/bin/python3

%{ for group, hosts in groups ~}
[${group}]
%{ for h in hosts ~}
${h} ansible_host=${servers[h].private_ip} fake_public_ip=${servers[h].public_ip} fake_instance_id=${servers[h].instance_id}
%{ endfor ~}

%{ endfor ~}
