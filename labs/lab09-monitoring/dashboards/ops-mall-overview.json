      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(mall_http_requests_total{job=\"mall-api\", namespace=~\"$namespace\", route!~\"GET /(healthz|readyz|metrics)\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(mall_http_requests_total{job=\"mall-api\", namespace=~\"$namespace\", route!~\"GET /(healthz|readyz|metrics)\"}[$__rate_interval]))",
          "legendFormat": "总 5xx 错误率",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (route, status) (rate(mall_http_requests_total{job=\"mall-api\", namespace=~\"$namespace\", route!~\"GET /(healthz|readyz|metrics)\", status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
    },
