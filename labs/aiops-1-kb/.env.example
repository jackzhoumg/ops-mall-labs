# 复制成 .env 后填写，然后：set -a; source .env; set +a
# 不要把 .env 提交到 Git（.gitignore 已忽略）

# ---- 对话模型（OpenAI 兼容接口）----
# 云厂商大模型平台的"OpenAI 兼容模式"地址一般形如 https://\<平台域名\>/\<路径\>/v1，以平台文档为准
# 本地 Ollama：http://127.0.0.1:11434/v1   本地 vLLM：http://<主机>:8000/v1
KB_CHAT_BASE_URL=https://llm.example.com/v1
KB_CHAT_API_KEY=sk-REPLACE_ME
KB_CHAT_MODEL=your-chat-model

# ---- 向量化模型 ----
# 不填 BASE_URL / API_KEY 时沿用上面对话模型的配置
#KB_EMBED_BASE_URL=http://127.0.0.1:11434/v1
#KB_EMBED_API_KEY=
KB_EMBED_MODEL=your-embedding-model
# 每次请求最多发几条（很多平台限制 10-25 条）
KB_EMBED_BATCH=10

# ---- 检索参数 ----
KB_TOP_K=4
# 最相关片段低于这个分数就不调大模型，直接回答"没找到"。不同 Embedding 模型分数分布不同，用 kb.py search 观察后调整
KB_MIN_SCORE=0.35
KB_KEYWORD_WEIGHT=0.2
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100

# ---- 群机器人（只发不收）----
#WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME
#DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME
#DINGTALK_SECRET=SECREPLACE_ME

# ---- 钉钉企业内部应用机器人（能收能回）----
#DINGTALK_APP_SECRET=REPLACE_ME
#BOT_ALLOWED_STAFF_IDS=
