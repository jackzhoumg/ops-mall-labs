diff --git a/app/handlers.go b/app/handlers.go
index 54d62e1..95f6afb 100644
--- a/app/handlers.go
+++ b/app/handlers.go
@@ -15,6 +15,9 @@ import (
 	"time"
 
 	"github.com/prometheus/client_golang/prometheus/promhttp"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/codes"
+	"go.opentelemetry.io/otel/trace"
 )
 
 const productsCacheKey = "mall:products"
@@ -72,6 +75,10 @@ func (a *App) middleware(next *http.ServeMux) http.Handler {
 		}
 		w.Header().Set("X-Request-ID", reqID)
 		w.Header().Set("X-Mall-Version", a.cfg.Version)
+		if sc := trace.SpanContextFromContext(r.Context()); sc.IsValid() {
+			// 把 trace_id 回给调用方：用户报障时贴出这个值，就能在 Jaeger 里直接打开这条链路。
+			w.Header().Set("X-Trace-ID", sc.TraceID().String())
+		}
 
 		a.metrics.httpInflight.Inc()
 		defer a.metrics.httpInflight.Dec()
@@ -84,6 +91,18 @@ func (a *App) middleware(next *http.ServeMux) http.Handler {
 		if route == "" {
 			route = "unmatched"
 		}
+		// 链路追踪：span 名改成路由模板，记下 request_id，5xx 标记为错误。
+		// 没启用追踪时 span 是空实现，这几行什么都不做。
+		span := trace.SpanFromContext(r.Context())
+		span.SetName(route)
+		span.SetAttributes(
+			attribute.String("http.route", route),
+			attribute.String("mall.request_id", reqID),
+		)
+		if rec.status >= 500 {
+			span.SetStatus(codes.Error, http.StatusText(rec.status))
+		}
+
 		dur := time.Since(start)
 		a.metrics.httpRequests.WithLabelValues(r.Method, route, strconv.Itoa(rec.status)).Inc()
 		a.metrics.httpDuration.WithLabelValues(r.Method, route).Observe(dur.Seconds())
@@ -198,7 +217,7 @@ func (a *App) handleListProducts(w http.ResponseWriter, r *http.Request) {
 
 	products, err := a.store.ListProducts(ctx)
 	if err != nil {
-		a.log.Error("list products failed", "err", err)
+		a.log.ErrorContext(ctx, "list products failed", "err", err)
 		writeError(w, http.StatusInternalServerError, "database error")
 		return
 	}
@@ -254,7 +273,7 @@ func (a *App) handleCreateOrder(w http.ResponseWriter, r *http.Request) {
 		writeError(w, http.StatusConflict, "insufficient stock")
 		return
 	case err != nil:
-		a.log.Error("create order failed", "err", err)
+		a.log.ErrorContext(r.Context(), "create order failed", "err", err)
 		writeError(w, http.StatusInternalServerError, "database error")
 		return
 	}
@@ -263,7 +282,7 @@ func (a *App) handleCreateOrder(w http.ResponseWriter, r *http.Request) {
 	if err := a.cache.Del(r.Context(), productsCacheKey); err != nil {
 		a.log.Warn("cache del failed", "err", err)
 	}
-	a.log.Info("order created", "order_id", o.ID, "product_id", o.ProductID, "quantity", o.Quantity, "amount_cents", o.AmountCents)
+	a.log.InfoContext(r.Context(), "order created", "order_id", o.ID, "product_id", o.ProductID, "quantity", o.Quantity, "amount_cents", o.AmountCents)
 	writeJSON(w, http.StatusCreated, o)
 }
 
