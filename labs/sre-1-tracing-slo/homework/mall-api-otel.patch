new file mode 100644
index 0000000..aad09ea
--- /dev/null
+++ b/app/tracing.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"context"
+	"log/slog"
+	"os"
+
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
+	"go.opentelemetry.io/otel/propagation"
+	"go.opentelemetry.io/otel/sdk/resource"
+	sdktrace "go.opentelemetry.io/otel/sdk/trace"
+	"go.opentelemetry.io/otel/trace"
+)
+
+// setupTracing 初始化 OpenTelemetry 链路追踪（SRE-1 课后作业）。
+//
+// 只有设置了 OTEL_EXPORTER_OTLP_ENDPOINT（如 http://otel-collector.monitoring.svc:4317）才启用；
+// 不设置时什么都不做，行为和改造前完全一样。
+// 采样率、服务名等都用 OpenTelemetry 标准环境变量控制：
+//
+//	OTEL_SERVICE_NAME=mall-api
+//	OTEL_TRACES_SAMPLER=parentbased_traceidratio
+//	OTEL_TRACES_SAMPLER_ARG=0.1
+func setupTracing(ctx context.Context, version string) (func(context.Context) error, error) {
+	// 不管是否导出，都注册 W3C traceparent 传播器：网关传进来的 trace 上下文能继续往下传。
+	otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(
+		propagation.TraceContext{}, propagation.Baggage{},
+	))
+
+	if os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT") == "" && os.Getenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT") == "" {
+		return func(context.Context) error { return nil }, nil
+	}
+
+	exp, err := otlptracegrpc.New(ctx) // 读取 OTEL_EXPORTER_OTLP_* 环境变量
+	if err != nil {
+		return nil, err
+	}
+
+	res, err := resource.New(ctx,
+		resource.WithAttributes(
+			attribute.String("service.name", "mall-api"),
+			attribute.String("service.version", version),
+		),
+		resource.WithFromEnv(), // OTEL_SERVICE_NAME / OTEL_RESOURCE_ATTRIBUTES 可以覆盖上面的值
+		resource.WithHost(),
+		resource.WithTelemetrySDK(),
+	)
+	if err != nil {
+		return nil, err
+	}
+
+	tp := sdktrace.NewTracerProvider(
+		sdktrace.WithBatcher(exp), // 批量异步发送，不阻塞请求
+		sdktrace.WithResource(res),
+		// 不显式设置 Sampler：SDK 默认读 OTEL_TRACES_SAMPLER，未设置时是 parentbased_always_on，
+		// 也就是“网关采样了我就采样”，保证一条链路要么完整、要么都不要。
+	)
+	otel.SetTracerProvider(tp)
+	return tp.Shutdown, nil
+}
+
+// traceHandler 包一层 slog.Handler：日志带上 context 时，自动加上 trace_id / span_id 字段，
+// 这样在 Loki / Kibana 里按 trace_id 就能搜到这条链路上的所有日志。
+type traceHandler struct{ slog.Handler }
+
+func (h traceHandler) Handle(ctx context.Context, r slog.Record) error {
+	if sc := trace.SpanContextFromContext(ctx); sc.IsValid() {
+		r.AddAttrs(
+			slog.String("trace_id", sc.TraceID().String()),
+			slog.String("span_id", sc.SpanID().String()),
+		)
+	}
+	return h.Handler.Handle(ctx, r)
+}
+
+func (h traceHandler) WithAttrs(attrs []slog.Attr) slog.Handler {
+	return traceHandler{h.Handler.WithAttrs(attrs)}
+}
+
+func (h traceHandler) WithGroup(name string) slog.Handler {
+	return traceHandler{h.Handler.WithGroup(name)}
+}
