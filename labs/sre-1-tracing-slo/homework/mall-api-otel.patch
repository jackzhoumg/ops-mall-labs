--- a/app/main.go
+++ b/app/main.go
@@ -13,6 +13,8 @@ import (
 	"os/signal"
 	"syscall"
 	"time"
+
+	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
 )
 
 // version 在构建时通过 -ldflags "-X main.version=v1.0.0" 注入，也可以用 MALL_VERSION 覆盖。
@@ -23,6 +25,12 @@ func main() {
 	logger := newLogger(cfg.LogLevel)
 	slog.SetDefault(logger)
 
+	shutdownTracing, err := setupTracing(context.Background(), cfg.Version)
+	if err != nil {
+		logger.Error("init tracing failed", "err", err)
+		os.Exit(1)
+	}
+
 	store, err := newSQLStore(cfg.DBDSN)
