# /etc/mysql/mysql.conf.d/mall.cnf（lab-db2，从库）
# 和主库只差三处：server-id=2、relay-log、read_only。和 Lab 03 roles/mysql/templates/mall.cnf.j2 渲染结果一致
# 改完：sudo systemctl restart mysql
[mysqld]
bind-address=0.0.0.0
port=3306
skip-name-resolve
max_connections=500
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
innodb_buffer_pool_size=512M
# ---- 复制 ----
server-id=2
# 从库也开 binlog：主库挂了从库要能顶上当主库，它的 binlog 才能给别人复制
log-bin=mysql-bin
binlog_expire_logs_seconds=604800
gtid_mode=ON
enforce_gtid_consistency=ON
relay-log=relay-bin
# 从库只读，防止有人误写；root 等有 SUPER 权限的账号不受 read_only 限制
read_only=ON
# ---- 慢查询 ----
slow_query_log=ON
slow_query_log_file=/var/log/mysql/mysql-slow.log
long_query_time=1
