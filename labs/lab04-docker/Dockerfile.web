# mall-web 镜像：官方 nginx + 静态页面 + /api/ 反代
#
# 构建上下文是仓库根目录（在仓库根目录执行）：
#   docker build -f labs/lab04-docker/Dockerfile.web --build-arg VERSION=v1.0.0 \
#     -t harbor.lab.local/mall/mall-web:v1.0.0 .
#
# 运行时通过环境变量指定后端，不用为每个环境重新打镜像：
#   MALL_API_UPSTREAM  后端地址，默认 mall-api:8080（Compose 里的服务名）
#   NGINX_RESOLVER     DNS 服务器，默认 127.0.0.11（Docker 内置 DNS）

# 写作时 nginx 稳定版是 1.30
FROM nginx:1.30-alpine

ARG VERSION=dev
LABEL org.opencontainers.image.title="mall-web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/jackzhoumg/ops-mall-labs"

# 官方镜像启动时会把 /etc/nginx/templates/*.template 用 envsubst 渲染到 /etc/nginx/conf.d/
# 只替换已定义的环境变量，$host 这类 nginx 变量不会被误替换
ENV MALL_API_UPSTREAM=mall-api:8080 \
    NGINX_RESOLVER=127.0.0.11

# 删掉自带的 default.conf，避免和我们的站点抢 80 端口
RUN rm -f /etc/nginx/conf.d/default.conf

COPY labs/lab04-docker/nginx/mall.conf.template /etc/nginx/templates/mall.conf.template
COPY web/index.html /usr/share/nginx/html/index.html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/nginx-health || exit 1
