# 复制成 .env 再修改：cp .env.example .env
# .env 里有密码，仓库根目录的 .gitignore 已忽略 .env，不会被提交

MYSQL_ROOT_PASSWORD=ChangeMe-Root-123
# 应用账号密码，必须和 sql/init.sql 里的一致（课程约定 MallPass123）
MALL_DB_PASSWORD=MallPass123
REDIS_PASSWORD=ChangeMe-Redis-123

# 镜像 tag，不用 latest
MALL_VERSION=v1.0.0
MALL_DEBUG=false
# 商城页面对外端口（80/443 留给 Harbor）
MALL_WEB_PORT=8088
