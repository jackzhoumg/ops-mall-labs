# Node-2：Hoodi 测试网质押节点。复制成 .env 后修改。只在测试网使用，不要放任何主网密钥。
# 写作时版本，以官方发布页为准
GETH_IMAGE=ethereum/client-go:v1.17.10
LIGHTHOUSE_IMAGE=sigp/lighthouse:v8.3.3
MEV_BOOST_IMAGE=flashbots/mev-boost:1.12

# 和 Node-1 用同一个数据目录：Node-1 已经同步好的 Hoodi 数据可以直接复用（先停掉 Node-1 的 compose）
DATA_DIR=/data/eth
# 验证者客户端的数据（密钥、slashing protection 数据库）单独放
VC_DATA_DIR=/data/eth/validator

CHECKPOINT_SYNC_URL=https://hoodi.checkpoint.sigp.io
METRICS_BIND=192.168.56.31

# 手续费接收地址（出块时的优先费和 MEV 收益打到这里）。填你自己控制的 Hoodi 测试网地址
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# MEV-Boost 中继（Hoodi），来源：https://github.com/eth-clients/hoodi 的 MEV relay list。
# 多个用逗号分隔；实验先用一两个，启动时 -relay-check 会检查连通性
MEV_RELAYS=https://0xafa4c6985aa049fb79dd37010438cfebeb0f2bd42b115b89dd678dab0670c1de38da0c4e9138c9290a398ecd9a0b3110@boost-relay-hoodi.flashbots.net,https://0xb1559beef7b5ba3127485bbbb090362d9f497ba64e177ee2c8e7db74746306efad687f2cf8574e38d70067d40ef136dc@relay-hoodi.ultrasound.money

# 图形化显示在区块里的标签，最长 32 字节
GRAFFITI=ops-class-lab
